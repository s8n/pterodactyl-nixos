{
  config,
  lib,
  pkgs,
  ...
}:

let
  cfg = config.services.pterodactyl-panel;
  inherit (lib)
    mkEnableOption
    mkIf
    mkMerge
    mkOption
    mkDefault
    literalExpression
    types
    ;

  package = cfg.package.override { inherit (cfg) dataDir; };
  php = package.phpPackage;
  appDir = "${package}/share/php/pterodactyl-panel";

  redisServer = config.services.redis.servers.pterodactyl-panel;
  mysqlSocket = "/run/mysqld/mysqld.sock";

  # Runs artisan as the panel user, from wherever it is invoked.
  artisan = pkgs.writeShellScriptBin "pterodactyl-artisan" ''
    cd ${appDir}
    cmd=(${lib.getExe php} artisan "$@")
    if [[ "$(${pkgs.coreutils}/bin/id -un)" == ${lib.escapeShellArg cfg.user} ]]; then
      exec "''${cmd[@]}"
    elif [[ "$(${pkgs.coreutils}/bin/id -u)" == 0 ]]; then
      exec ${pkgs.util-linux}/bin/runuser -u ${lib.escapeShellArg cfg.user} -- "''${cmd[@]}"
    else
      exec /run/wrappers/bin/sudo -u ${lib.escapeShellArg cfg.user} -- "''${cmd[@]}"
    fi
  '';

  # A file on the target machine. Path literals and store paths are rejected:
  # they would put the secret into the world-readable Nix store.
  secretPath = types.pathWith {
    inStore = false;
    absolute = true;
  };

  secretType = types.submodule {
    options._secret = mkOption {
      type = secretPath;
      description = "Path to a file whose contents are used as the value. Read at service start.";
    };
  };

  settingValue = types.nullOr (
    types.oneOf [
      types.bool
      types.int
      types.str
      types.path
      secretType
    ]
  );

  # Renders one .env line in bash. Values are always double-quoted and escaped
  # for phpdotenv, so any string is safe. Secrets are read at runtime.
  mkEnvLine =
    name: value:
    let
      key = lib.escapeShellArg name;
    in
    if value == null then
      ""
    else if lib.isAttrs value && value ? _secret then
      "env_secret ${key} ${lib.escapeShellArg value._secret}"
    else if lib.isBool value then
      "env_line ${key} ${lib.boolToString value}"
    else if lib.isPath value then
      # Interpolation copies the file into the store; toString wouldn't.
      "env_line ${key} ${lib.escapeShellArg "${value}"}"
    else
      "env_line ${key} ${lib.escapeShellArg (toString value)}";

  writeEnvFile = pkgs.writeShellScript "pterodactyl-panel-write-env" ''
    set -euo pipefail
    env_line() {
      local v="$2"
      v="''${v//\\/\\\\}"
      v="''${v//\"/\\\"}"
      v="''${v//\$/\\\$}"
      printf '%s="%s"\n' "$1" "$v"
    }
    env_secret() {
      local v
      if ! v="$(< "$2")"; then
        echo "Cannot read the file for $1: $2" >&2
        exit 1
      fi
      env_line "$1" "$v"
    }
    {
      echo "# Generated by the NixOS module; edits are overwritten on restart."
      ${lib.concatStringsSep "\n  " (lib.mapAttrsToList mkEnvLine cfg.settings)}
    } > "$1.tmp"
    mv "$1.tmp" "$1"
  '';

  initialAdminScript = lib.optionalString (cfg.initialAdmin != null) ''
    marker=${lib.escapeShellArg cfg.dataDir}/.initial-admin-created
    if [[ ! -e "$marker" ]]; then
      ${lib.getExe php} ${./initial-admin.php} ${
        lib.escapeShellArgs (
          with cfg.initialAdmin;
          [
            email
            username
            firstName
            lastName
          ]
        )
      }
      touch "$marker"
    fi
  '';

  dbService = lib.optional cfg.database.createLocally "mysql.service";
  redisService = lib.optional cfg.redis.createLocally "redis-pterodactyl-panel.service";
in
{
  options.services.pterodactyl-panel = {
    enable = mkEnableOption "Pterodactyl Panel, a game server management panel";

    package = mkOption {
      type = types.package;
      default = pkgs.pterodactyl-panel;
      defaultText = literalExpression "pkgs.pterodactyl-panel";
      description = ''
        The Pterodactyl Panel package. It is overridden with this module's
        `dataDir`, so it must accept a `dataDir` argument.
      '';
    };

    user = mkOption {
      type = types.str;
      default = "pterodactyl";
      description = "User the panel (PHP-FPM, queue worker, scheduler) runs as.";
    };

    group = mkOption {
      type = types.str;
      default = "pterodactyl";
      description = "Group the panel runs as.";
    };

    dataDir = mkOption {
      type = types.path;
      default = "/var/lib/pterodactyl-panel";
      description = "Directory holding the generated `.env`, `storage/` and generated secrets.";
    };

    hostName = mkOption {
      type = types.str;
      example = "panel.example.com";
      description = "Domain the panel is served on. Used for the nginx virtual host and the default `APP_URL`.";
    };

    appKeyFile = mkOption {
      type = types.nullOr secretPath;
      default = null;
      example = "/run/secrets/pterodactyl-app-key";
      description = ''
        File containing the Laravel `APP_KEY` (`base64:` followed by 32 random
        bytes in base64). If null, a key is generated on first start and kept in
        `''${dataDir}/secrets/app-key`.

        Back this key up: losing it makes encrypted data (node tokens, database
        host passwords, 2FA secrets) unreadable.
      '';
    };

    hashidsSaltFile = mkOption {
      type = types.nullOr secretPath;
      default = null;
      description = ''
        File containing the `HASHIDS_SALT`. If null, one is generated on first
        start and kept in `''${dataDir}/secrets/hashids-salt`.
      '';
    };

    database = {
      createLocally = mkOption {
        type = types.bool;
        default = true;
        description = ''
          Whether to set up a local MariaDB database and user. The panel connects
          over the Unix socket with socket authentication, so no password is needed.
        '';
      };
      host = mkOption {
        type = types.str;
        default = "127.0.0.1";
        description = "Database host. Ignored when `createLocally` is set.";
      };
      port = mkOption {
        type = types.port;
        default = 3306;
        description = "Database port. Ignored when `createLocally` is set.";
      };
      name = mkOption {
        type = types.str;
        default = "panel";
        description = "Database name.";
      };
      user = mkOption {
        type = types.str;
        default = cfg.user;
        defaultText = literalExpression "config.services.pterodactyl-panel.user";
        description = "Database user. Must equal `user` when `createLocally` is set.";
      };
      passwordFile = mkOption {
        type = types.nullOr secretPath;
        default = null;
        description = "File containing the database password, for remote databases.";
      };
    };

    redis.createLocally = mkOption {
      type = types.bool;
      default = true;
      description = ''
        Whether to run a dedicated local Redis instance, reached over a Unix
        socket, and use it for the cache, sessions and the job queue. If false,
        configure `REDIS_*`, `CACHE_STORE`, `SESSION_DRIVER` and
        `QUEUE_CONNECTION` through `settings` yourself.
      '';
    };

    initialAdmin = mkOption {
      default = null;
      description = ''
        An administrator account to create on first start. It is created once;
        changing these values afterwards has no effect. If a user with the
        same email or username already exists, it is left as it is. Set to
        null to create users manually with `pterodactyl-artisan p:user:make`.
      '';
      type = types.nullOr (
        types.submodule {
          options = {
            email = mkOption { type = types.str; };
            username = mkOption { type = types.str; };
            firstName = mkOption {
              type = types.str;
              default = "Admin";
            };
            lastName = mkOption {
              type = types.str;
              default = "User";
            };
            passwordFile = mkOption {
              type = secretPath;
              description = "File containing the initial password (minimum 8 characters).";
            };
          };
        }
      );
    };

    settings = mkOption {
      default = { };
      description = ''
        Environment variables written to the panel's `.env` file. See
        upstream's `.env.example` and `config/*.php` for what's available.

        A value can be `{ _secret = "/path/to/file"; }` to read it from a file
        at service start, which keeps secrets out of the Nix store.

        The file is regenerated on every start of
        `pterodactyl-panel-setup.service`, so changes made through
        `php artisan p:environment:*` do not persist; set them here instead.
      '';
      example = literalExpression ''
        {
          APP_TIMEZONE = "Europe/Berlin";
          MAIL_MAILER = "smtp";
          MAIL_HOST = "smtp.example.com";
          MAIL_PORT = 587;
          MAIL_USERNAME = "panel@example.com";
          MAIL_PASSWORD._secret = "/run/secrets/pterodactyl-smtp";
          MAIL_FROM_ADDRESS = "panel@example.com";
          TRUSTED_PROXIES = "127.0.0.1";
        }
      '';
      type = types.submodule {
        freeformType = types.attrsOf settingValue;
        options = {
          APP_URL = mkOption {
            type = types.str;
            default =
              let
                vhost = config.services.nginx.virtualHosts.${cfg.hostName};
                https = cfg.enableNginx && (vhost.forceSSL || vhost.onlySSL);
              in
              "http${lib.optionalString https "s"}://${cfg.hostName}";
            defaultText = literalExpression ''"https://''${hostName}" if the nginx vhost forces SSL, else "http://''${hostName}"'';
            description = "Public URL of the panel. Wings and generated links use it.";
          };
          APP_TIMEZONE = mkOption {
            type = types.str;
            default = if config.time.timeZone != null then config.time.timeZone else "UTC";
            defaultText = literalExpression ''config.time.timeZone or "UTC"'';
            description = "Timezone used by the panel.";
          };
          APP_ENVIRONMENT_ONLY = mkOption {
            type = types.bool;
            default = true;
            description = ''
              If true, settings come only from this file. If false, the admin
              area's settings pages are enabled and override values from the
              database.
            '';
          };
        };
      };
    };

    enableNginx = mkOption {
      type = types.bool;
      default = true;
      description = ''
        Whether to serve the panel through nginx on `hostName`. Further
        virtual host options (TLS, ACME, listen addresses) can be set on
        `services.nginx.virtualHosts.''${hostName}`.
      '';
    };

    phpfpm.settings = mkOption {
      type =
        with types;
        attrsOf (oneOf [
          str
          int
          bool
        ]);
      default = { };
      description = "Extra settings for the panel's PHP-FPM pool, merged over the defaults.";
    };

    queueWorker.extraArgs = mkOption {
      type = types.listOf types.str;
      default = [ ];
      example = [ "--timeout=120" ];
      description = "Extra arguments for `artisan queue:work`.";
    };
  };

  config = mkIf cfg.enable {
    assertions = [
      {
        assertion = cfg.database.createLocally -> cfg.database.user == cfg.user;
        message = "services.pterodactyl-panel.database.user must equal services.pterodactyl-panel.user when database.createLocally is enabled (MariaDB socket auth).";
      }
    ];

    services.pterodactyl-panel.settings = mkMerge [
      {
        APP_ENV = mkDefault "production";
        APP_DEBUG = mkDefault false;
        APP_KEY = mkDefault {
          _secret = if cfg.appKeyFile != null then cfg.appKeyFile else "${cfg.dataDir}/secrets/app-key";
        };
        HASHIDS_SALT = mkDefault {
          _secret =
            if cfg.hashidsSaltFile != null then cfg.hashidsSaltFile else "${cfg.dataDir}/secrets/hashids-salt";
        };
        HASHIDS_LENGTH = mkDefault 8;
        LOG_CHANNEL = mkDefault "daily";
        LOG_LEVEL = mkDefault "info";
        MAIL_MAILER = mkDefault "log";

        DB_CONNECTION = mkDefault "mysql";
        DB_DATABASE = mkDefault cfg.database.name;
        DB_USERNAME = mkDefault cfg.database.user;
      }
      (mkIf cfg.database.createLocally {
        DB_SOCKET = mkDefault mysqlSocket;
      })
      (mkIf (!cfg.database.createLocally) {
        DB_HOST = mkDefault cfg.database.host;
        DB_PORT = mkDefault cfg.database.port;
        DB_PASSWORD = mkIf (cfg.database.passwordFile != null) (mkDefault {
          _secret = cfg.database.passwordFile;
        });
      })
      (mkIf cfg.redis.createLocally {
        REDIS_SCHEME = mkDefault "unix";
        REDIS_PATH = mkDefault redisServer.unixSocket;
        CACHE_STORE = mkDefault "redis";
        SESSION_DRIVER = mkDefault "redis";
        QUEUE_CONNECTION = mkDefault "redis";
      })
    ];

    users.users.${cfg.user} = {
      isSystemUser = true;
      group = cfg.group;
      home = cfg.dataDir;
      extraGroups = lib.optional cfg.redis.createLocally redisServer.group;
    };
    users.groups.${cfg.group} = { };

    environment.systemPackages = [ artisan ];

    services.mysql = mkIf cfg.database.createLocally {
      enable = true;
      package = mkDefault pkgs.mariadb;
      ensureDatabases = [ cfg.database.name ];
      ensureUsers = [
        {
          name = cfg.database.user;
          ensurePermissions."${cfg.database.name}.*" = "ALL PRIVILEGES";
        }
      ];
    };

    services.redis.servers.pterodactyl-panel = mkIf cfg.redis.createLocally {
      enable = true;
      port = 0; # socket only
    };

    systemd.tmpfiles.settings."10-pterodactyl-panel" =
      let
        dir = {
          d = {
            inherit (cfg) user group;
            mode = "0750";
          };
        };
      in
      lib.genAttrs (map (p: "${cfg.dataDir}/${p}") [
        ""
        "secrets"
        "bootstrap-cache"
        "storage"
        "storage/app"
        "storage/app/private"
        "storage/app/public"
        "storage/clockwork"
        "storage/framework"
        "storage/framework/cache"
        "storage/framework/sessions"
        "storage/framework/views"
        "storage/logs"
      ]) (_: dir);

    systemd.services.pterodactyl-panel-setup = {
      description = "Pterodactyl Panel configuration and database migrations";
      wantedBy = [ "multi-user.target" ];
      requires = dbService ++ redisService;
      after = dbService ++ redisService;
      # Re-run migrations whenever the package or configuration changes.
      restartTriggers = [
        package
        writeEnvFile
      ];
      path = [
        pkgs.coreutils
        # Laravel loads database/schema/mysql-schema.sql with the mysql CLI.
        pkgs.mariadb.client
      ];
      serviceConfig = {
        Type = "oneshot";
        RemainAfterExit = true;
        User = cfg.user;
        Group = cfg.group;
        WorkingDirectory = appDir;
        UMask = "0077";
        LoadCredential = lib.optional (
          cfg.initialAdmin != null
        ) "initial-admin-password:${cfg.initialAdmin.passwordFile}";
      };
      script = ''
        secrets=${lib.escapeShellArg cfg.dataDir}/secrets
        ${lib.optionalString (cfg.appKeyFile == null) ''
          if [[ ! -s "$secrets/app-key" ]]; then
            echo "Generating APP_KEY"
            echo "base64:$(head -c 32 /dev/urandom | base64)" > "$secrets/app-key"
          fi
        ''}
        ${lib.optionalString (cfg.hashidsSaltFile == null) ''
          if [[ ! -s "$secrets/hashids-salt" ]]; then
            echo "Generating HASHIDS_SALT"
            salt="$(head -c 64 /dev/urandom | base64 -w0 | tr -dc 'A-Za-z0-9')"
            printf '%s' "''${salt:0:20}" > "$secrets/hashids-salt"
          fi
        ''}

        ${writeEnvFile} ${lib.escapeShellArg cfg.dataDir}/.env

        # Cached manifests/config from an older package version would be stale.
        # Not `optimize:clear`: its `cache:clear` flushes the Redis database
        # that also holds the job queue and sessions.
        rm -f ${lib.escapeShellArg cfg.dataDir}/bootstrap-cache/*.php
        ${lib.getExe php} artisan view:clear
        ${lib.getExe php} artisan migrate --force

        # Seeding re-imports the stock eggs, overwriting edits made to them in
        # the UI. Upstream does this on upgrades only, so do the same.
        seeded=${lib.escapeShellArg cfg.dataDir}/.seeded-version
        if [[ "$(cat "$seeded" 2>/dev/null)" != ${lib.escapeShellArg package.version} ]]; then
          ${lib.getExe php} artisan db:seed --force
          echo ${lib.escapeShellArg package.version} > "$seeded"
        fi
        ${initialAdminScript}
      '';
    };

    services.phpfpm.pools.pterodactyl-panel = {
      inherit (cfg) user group;
      phpPackage = php;
      phpOptions = ''
        upload_max_filesize = 100M
        post_max_size = 100M
      '';
      settings = {
        "listen.owner" = config.services.nginx.user;
        "listen.group" = config.services.nginx.group;
        "listen.mode" = "0660";
        "pm" = "dynamic";
        "pm.max_children" = 16;
        "pm.start_servers" = 2;
        "pm.min_spare_servers" = 2;
        "pm.max_spare_servers" = 4;
        "pm.max_requests" = 500;
        "catch_workers_output" = true;
      }
      // cfg.phpfpm.settings;
    };

    systemd.services.phpfpm-pterodactyl-panel = {
      # Only ordering: restarting the setup unit shouldn't bounce the web server.
      wants = [ "pterodactyl-panel-setup.service" ];
      after = [ "pterodactyl-panel-setup.service" ];
    };

    systemd.services.pterodactyl-panel-queue = {
      description = "Pterodactyl Panel queue worker";
      wantedBy = [ "multi-user.target" ];
      requires = [ "pterodactyl-panel-setup.service" ];
      after = [ "pterodactyl-panel-setup.service" ];
      # The worker caches configuration, so restart it when the .env changes.
      restartTriggers = [
        package
        writeEnvFile
      ];
      serviceConfig = {
        User = cfg.user;
        Group = cfg.group;
        WorkingDirectory = appDir;
        ExecStart = lib.escapeShellArgs (
          [
            (lib.getExe php)
            "artisan"
            "queue:work"
            "--queue=high,standard,low"
            "--sleep=3"
            "--tries=3"
          ]
          ++ cfg.queueWorker.extraArgs
        );
        Restart = "always";
        RestartSec = 5;
      };
    };

    systemd.services.pterodactyl-panel-scheduler = {
      description = "Pterodactyl Panel task scheduler";
      requires = [ "pterodactyl-panel-setup.service" ];
      after = [ "pterodactyl-panel-setup.service" ];
      serviceConfig = {
        Type = "oneshot";
        User = cfg.user;
        Group = cfg.group;
        WorkingDirectory = appDir;
        ExecStart = "${lib.getExe php} artisan schedule:run";
      };
    };

    systemd.timers.pterodactyl-panel-scheduler = {
      wantedBy = [ "timers.target" ];
      timerConfig = {
        OnCalendar = "minutely";
        AccuracySec = "1s";
      };
    };

    services.nginx = mkIf cfg.enableNginx {
      enable = true;
      recommendedGzipSettings = mkDefault true;
      recommendedOptimisation = mkDefault true;
      recommendedProxySettings = mkDefault true;
      virtualHosts.${cfg.hostName} = {
        root = mkDefault "${appDir}/public";
        extraConfig = ''
          index index.php;
          client_max_body_size 100m;
          client_body_timeout 120s;
          charset utf-8;
        '';
        locations = {
          "/".tryFiles = "$uri $uri/ /index.php?$query_string";
          "= /favicon.ico".extraConfig = "access_log off; log_not_found off;";
          "= /robots.txt".extraConfig = "access_log off; log_not_found off;";
          "~ /\\.ht".extraConfig = "deny all;";
          "~ \\.php$".extraConfig = ''
            fastcgi_split_path_info ^(.+\.php)(/.+)$;
            fastcgi_pass unix:${config.services.phpfpm.pools.pterodactyl-panel.socket};
            fastcgi_index index.php;
            include ${config.services.nginx.package}/conf/fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param HTTP_PROXY "";
            fastcgi_intercept_errors off;
            fastcgi_buffer_size 16k;
            fastcgi_buffers 4 16k;
            fastcgi_connect_timeout 300;
            fastcgi_send_timeout 300;
            fastcgi_read_timeout 300;
          '';
        };
      };
    };
  };
}
